APP_NAME="جمعية إعجاز"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# فهرسة محركات البحث (robots.txt): true في الإنتاج وحده
SEO_INDEXABLE=false
# صورة مقطع يوتيوب المصغرة في المكتبة تُجلب من الخادم مرة وتُحفظ محلياً (FetchYoutubeThumbnail)
YOUTUBE_THUMBNAILS=true

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_DISPLAY_TIMEZONE=Asia/Riyadh
# true على رابط العرض: علامات 【ناقص】 لا يراها الزائر، وتبقى للإدارة (ملاحظة ٣٠). والإنتاج يخفيها دائماً
HIDE_MISSING_MARKERS=false

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# داخل الحاويات اسم خادم قاعدة البيانات هو pgsql
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ejaz
DB_USERNAME=ejaz
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# مدة «تذكّرني» بالدقائق (30 يوماً)
AUTH_REMEMBER_MINUTES=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# قرص الملفات الخاصة (الوثائق): محلي في التطوير، وS3 داخل المملكة في الإنتاج
FILESYSTEM_PRIVATE_DISK=local
PUBLIC_ORPHAN_DAYS=7
# الملفات الشخصية في القرص الخاص بلا سجل تُحذف بعد هذه الأيام (ejaz:prune-orphan-private-files، أسبوعياً)
PRIVATE_ORPHAN_DAYS=1
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ejaz

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# كلمة مرور Redis مطلوبة حتى في التطوير، ويولّدها scripts/setup.sh عشوائية
REDIS_PASSWORD=
REDIS_PORT=6379

# البريد في التطوير يذهب إلى Mailpit: http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@ejaz.sa"
MAIL_FROM_NAME="${APP_NAME}"

# التخزين السحابي (يُفعّل في مرحلة المسابقات — انظر docs/decisions.md)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# مزود الرسائل النصية (docs/guides/messaging.md): المعتاد ضبطه من «قنوات التواصل» في اللوحة، فيتقدم على ما هنا.
# log يكتب الرسائل في السجل (للتطوير فقط)، أو taqnyat أو unifonic أو msegat بمفتاحه (SMS_USERNAME لمسجات وحدها)
SMS_DRIVER=log
SMS_SENDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_REQUEST_UPDATES=false

# التحدي ضد الآليات على إرسال غير المسجلين في الاستبيان العام: fake للتطوير (يرفض العمل في الإنتاج)،
# وturnstile بمفتاحي Cloudflare في الإنتاج (docs/decisions.md)
BOT_CHALLENGE_DRIVER=fake
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BOT_CHALLENGE_CEILING_FACTOR=5
# رسائل تنبيه صاحب الحساب بقفل دخوله: في اليوم للبوابة كلها، وفي الأسبوع لكل حساب، وبعدهما بالبريد وحده
LOGIN_CHALLENGE_SMS_PER_DAY=200
LOGIN_CHALLENGE_SMS_PER_ACCOUNT_PER_WEEK=2
# كشف رقم هوية طالب في اللوحة: حد لكل مستخدم في الساعة بعد تأكيد كلمة المرور
NATIONAL_ID_REVEALS_PER_HOUR=60
# معرض الشواهد برابط سري: فتح الصفحة وملفاتها في الدقيقة لكل مشترك، ومدة رابط الملف الموقّع ورابط التخزين بعده بالدقائق
EVIDENCE_PER_MINUTE=20
EVIDENCE_FILES_PER_MINUTE=300
EVIDENCE_FILE_URL_MINUTES=30
EVIDENCE_STORAGE_URL_MINUTES=5

# اجتماعات تيمز للجمعية العمومية: fake للتطوير (يرفض العمل في الإنتاج)، وgraph بمفتاح تطبيق الجمعية
# في Microsoft 365، ومفاتيحه من اللوحة («ربط تيمز» للمشرف العام — docs/guides/teams-meetings.md)
ONLINE_MEETINGS_DRIVER=fake

# المساعد الذكي: التشغيل والمزود والنموذج من لوحة الإدارة (docs/guides/ai-assistant.md). والمفتاح هنا اختياري، لكل
# مزود مفتاحه، ويُقدَّم لمزوده وحده على المحفوظ مشفّراً في اللوحة. والمهلة بالثواني، والطلبات المتزامنة من البوابة كلها
AI_ASSISTANT_ANTHROPIC_KEY=
AI_ASSISTANT_OPENAI_KEY=
# حد المخرج في Chat Completions: max_completion_tokens (نماذج OpenAI الأحدث)، أو max_tokens لخادم أقدم متوافق
AI_ASSISTANT_OPENAI_TOKEN_PARAMETER=max_completion_tokens
AI_ASSISTANT_TIMEOUT=15
AI_ASSISTANT_CONCURRENCY=4
AI_ASSISTANT_PER_MINUTE=30
# نطاقات المزودين المسموح أن يُرسل إليها المفتاح، مفصولة بفواصل. ونطاق نموذج مستضاف داخل المملكة يُضاف هنا قبل اختياره
AI_ASSISTANT_ALLOWED_HOSTS=api.anthropic.com,api.openai.com

# مدة الاحتفاظ بسجل العمليات بالأيام قبل حذفه آلياً (docs/decisions.md)
ACTIVITYLOG_RETENTION_DAYS=365

# مدة خمول جلسة لوحة الإدارة بالدقائق
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_MAX_MINUTES=480

# الإنتاج خلف موزع أحمال: عناوينه هنا (أو *)، وإلا رأى التطبيق عنوان الموزع لكل الزوار
TRUSTED_PROXIES=
# حدود التسجيل (config/security.php): لكل مشترك ولكل جهاز في الساعة، ولكل شبكة /24 في اليوم، وللبوابة في الساعة
REGISTRATION_PER_IP_PER_HOUR=120
REGISTRATION_PER_DEVICE_PER_HOUR=5
REGISTRATION_PER_NETWORK_PER_DAY=2000
REGISTRATION_PER_HOUR=3000
SMS_PER_HOUR=5000
# الحساب الذي لم يوثّق جواله ولا ارتبط بسجل يُحذف بعد هذه الأيام (ejaz:prune-unverified-accounts)
UNVERIFIED_ACCOUNT_DAYS=14
# تنبيه المشرف العام بعد عدد رموز التحقق الثنائي الخاطئة على حساب في اليوم (0 يوقفه، وأقل من 30)
TWO_FACTOR_ALERT_THRESHOLD=5
# رفع ملفات اللوحة المؤقت لكل حساب (0 بلا حد)
UPLOADS_PER_MINUTE=30
UPLOADS_PER_HOUR=300
SMS_PENDING_PER_IPV4_NETWORK=200
SMS_SENT_PER_IPV4_NETWORK=500
SMS_PENDING_PER_IPV6_SUBSCRIBER=20
SMS_SENT_PER_IPV6_SUBSCRIBER=25
SMS_PENDING_PER_IPV6_SITE=200
SMS_SENT_PER_IPV6_SITE=500
CONTACT_PER_SUBSCRIBER_PER_HOUR=20
CONTACT_PER_IPV6_SITE_PER_HOUR=60
CONTACT_PER_HOUR=300
PASSWORD_RESET_PER_SUBSCRIBER_PER_HOUR=20
PASSWORD_UPDATE_PER_IDENTITY_PER_MINUTE=5
PASSWORD_UPDATE_PER_SUBSCRIBER_PER_MINUTE=120
LOGIN_FAILURES_PER_SUBSCRIBER=50
LOGIN_FAILURES_PER_IPV6_SITE=150
LOGIN_FAILURES_PER_MINUTE=1200
LOGIN_ATTEMPTS_PER_SUBSCRIBER_PER_MINUTE=300

VITE_APP_NAME="${APP_NAME}"
# ويندوز: إذا لم تظهر تعديلات الواجهة تلقائياً اجعلها true
VITE_POLLING=false

# لبيئة الحاويات: رقم المستخدم والمجموعة على جهازك (يضبطهما scripts/setup.sh تلقائياً على ماك ولينكس)
UID=1000
GID=1000

# المسابقات (config/competitions.php): سقوف تقنية للنظام، لا حدود الجمعية. الحدود لكل سؤال من اللوحة
COMPETITION_VIDEO_MAX_MB=2048
COMPETITION_VIDEO_MAX_SECONDS=3600
COMPETITION_VIDEO_CHUNK_MB=5
COMPETITION_VIDEO_URL_MINUTES=120
COMPETITION_VIDEO_UPLOAD=app
COMPETITION_VIDEO_FFPROBE=ffprobe

# رفع اللوحة المؤقت (Livewire): فارغ = القرص المحلي (التطوير). وفي الإنتاج s3، فيرفع المتصفح إلى التخزين مباشرة
# ولا يمر الملف بخادم التطبيق. ويلزمه CORS الحاوية ونطاقها في CSP_CONNECT_SRC، كمقاطع المسابقات
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=

# الاختبار الإلكتروني (docs/plans/competition-exam.md). رقم الهوية ينتظر قرار صفوان، وإشعار واتساب يُفعَّل من «قنوات التواصل» أيضاً، فمعطّلان
COMPETITION_EXAM_NATIONAL_ID=false
COMPETITION_NATIONAL_ID_HMAC_KEY=
COMPETITION_EXAM_WHATSAPP=false
COMPETITION_EXAM_INTRO_TOLERANCE=3
COMPETITION_EXAM_MEDIA_MAX_MB=200
COMPETITION_EXAM_CACHE_MINUTES=60
COMPETITION_EXAM_MEDIA_URL_MINUTES=5
# مزود واتساب (docs/guides/messaging.md): المعتاد ضبطه من «قنوات التواصل» في اللوحة، فيتقدم على ما هنا.
# log يكتب الرسالة في السجل (للتطوير فقط)، أو cloud (WhatsApp Cloud API) برسائل قوالب معتمدة
WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_TEMPLATE_EXAM_RECEIPT=
# حدود قنوات التواصل ومدة سجلها (config/messaging.php)
MESSAGING_PER_NUMBER_PER_DAY=20
MESSAGING_EXAM_RECEIPT_PER_NUMBER_PER_DAY=10
MESSAGING_EXAM_RECEIPT_PER_DAY=40000
MESSAGING_TESTS_PER_HOUR=10
MESSAGING_TESTS_PER_DAY=30
MESSAGING_LOG_DAYS=90
MESSAGING_WEBHOOK_PER_MINUTE=1000
# رفع الأعمال في المسابقات: سقوف تقنية
COMPETITION_WORKS_MAX_ITEMS=10
COMPETITION_WORKS_IMAGE_MAX_KB=10240
COMPETITION_WORKS_PDF_MAX_KB=20480
COMPETITION_WORKS_URL_MINUTES=10

# الدفع (config/payments.php): fake للتطوير، وmoyasar في الإنتاج بمفاتيح حساب الجمعية في ميسر.
# PAYMENT_WEBHOOK_SECRET هو Secret Token المضبوط لنقطة الإشعار في لوحة ميسر. وفي الإنتاج يُضاف
# نطاق صفحة دفع ميسر إلى CSP_FORM_ACTION لأن المتصفح يفحصه عند التحويل بعد إرسال النموذج
# متجر الجمعية المعتمد على سلة، ونطاقاته المسموحة لرابطه في الإعدادات (مفصولة بفواصل)
STORE_URL=https://ejaz.org.sa
STORE_ALLOWED_HOSTS=ejaz.org.sa
# المتجر الداخلي والدفع والتبرعات بميسر مؤرشفة (قرار صفوان): true يعيد تشغيلها
PAYMENTS_ENABLED=false
PAYMENT_DRIVER=fake
PAYMENT_WEBHOOK_SECRET=
MOYASAR_SECRET_KEY=
DONATION_MIN_SAR=1
DONATION_MAX_SAR=100000
DONATIONS_PER_IP_PER_HOUR=20
DONATIONS_PER_HOUR=2000

# شهادة الحضور في الإنتاج بعد ضبط قالب الجمعية وحده (config/programs.php). وخارج الإنتاج بالقالب المؤقت
PROGRAM_CERTIFICATE_TEMPLATE_READY=false

# المتجر (config/store.php): settings يعرض بطاقات من إعدادات الموقع حتى تتوفر واجهة سلة
STORE_DRIVER=settings

# سياسة أمان المحتوى (config/security.php): نطاقات خارجية صريحة مفصولة بفواصل، فارغة في التطوير.
# CSP_IMG_SRC لنطاق التخزين وشبكة التوصيل إن قُدّمت منها الصور، وCSP_CONNECT_SRC لنطاق التخزين في الرفع المباشر
CSP_IMG_SRC=
CSP_CONNECT_SRC=
CSP_MEDIA_SRC=
# نطاق التخزين لعرض PDF الحوكمة والمكتبة مدمجاً متى كان القرص الخاص على S3 (برابط موقّع، CONTENT_FILE_URL_MINUTES)
CSP_FRAME_SRC=
CSP_FORM_ACTION=

# حدود فحص الصحة ejaz:health (config/health.php — docs/monitoring.md)
HEALTH_QUEUE_MAX_BACKLOG=1000
HEALTH_FAILED_JOBS_MAX=0
HEALTH_DISK_MIN_FREE_PERCENT=10
HEALTH_SCHEDULE_MAX_SILENCE_MINUTES=5

# كعكة الجلسة آمنة (Secure) افتراضياً متى كان APP_ENV=production. وفي التجريبية على https تُضبط صراحةً:
# SESSION_SECURE_COOKIE=true

# تخزين متوافق مع S3 لدى مزود غير AWS: when_required إن رفض مجاميع التحقق الإضافية (docs/deploy/provider-checklist.md)
AWS_REQUEST_CHECKSUM_CALCULATION=when_supported
AWS_RESPONSE_CHECKSUM_VALIDATION=when_supported
