# فحص الصحة العميق بحزمة الحاويات (docs/monitoring.md)، مع ejaz-health.timer في المجلد الأب.
[Unit]
Description=Ejaz portal health check (compose)
Requires=docker.service
# OnFailure=ejaz-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ejaz
ExecStart=/usr/bin/docker compose --env-file .env -f deploy/compose.production.yaml exec -T app php artisan ejaz:health
# نبض الصحة لأداة مراقبة خارجية، معلّق حتى قرار صفوان في الأداة (docs/decisions/2026-11-06-deploy-readiness.md).
# يُرسل بعد نجاح الفحص وحده، والرابط في Environment بملف drop-in (systemctl edit ejaz-health) لا في قيت
# ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${EJAZ_HEALTH_HEARTBEAT_URL}
