# النسخ الاحتياطي اليومي بحزمة الحاويات (deploy/compose.production.yaml، خدمة backup).
# /etc/systemd/system/ejaz-backup.service مع ejaz-backup.timer في المجلد الأب.
[Unit]
Description=Ejaz portal daily backup (compose)
After=docker.service network-online.target
Requires=docker.service
# OnFailure=ejaz-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ejaz
ExecStart=/usr/bin/docker compose --env-file .env -f deploy/compose.production.yaml run --rm backup
# نبض النجاح لأداة مراقبة خارجية، معلّق حتى قرار صفوان في الأداة (docs/decisions/2026-11-06-deploy-readiness.md).
# يُرسل بعد نجاح النسخة وحده، فغيابه يوماً ينبّه. والرابط في Environment بملف drop-in (systemctl edit ejaz-backup) لا في قيت
# ExecStartPost=/usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null ${EJAZ_BACKUP_HEARTBEAT_URL}
