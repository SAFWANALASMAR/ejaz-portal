# إعدادات النسخ الاحتياطي (scripts/backup.sh) — تُنسخ إلى .env.backup على الخادم (صلاحية 600).
# حاوية النسخ منفصلة عن حاوية الملفات الحية، ومفاتيحها للكتابة بلا حذف (PutObject وListBucket بلا DeleteObject) على حاوية النسخ وحدها.
# ومدة الاحتفاظ بقاعدة دورة الحياة في الحاوية (deploy/storage/lifecycle-backups.json)، لا من الخادم.
PGHOST=pgsql
PGPORT=5432
PGDATABASE=ejaz
# دور للقراءة وحدها يكفي pg_dump (docs/deploy.md): CREATE ROLE ejaz_backup LOGIN PASSWORD '...'; GRANT pg_read_all_data TO ejaz_backup;
PGUSER=ejaz_backup
PGPASSWORD=
BACKUP_BUCKET=<حاوية النسخ>
BACKUP_S3_ENDPOINT=<عنوان واجهة S3 للمزود>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=<منطقة المزود>
# معرّف المفتاح العام (بريده أو بصمته)، وملفه على الخادم /etc/ejaz/backup-public.asc
BACKUP_GPG_RECIPIENT=
# القرص الخاص على S3 في الإنتاج فلا يُزامن (حمايته بإصدارات الحاوية)، والقرص العام محلي فيُزامن
BACKUP_SYNC_FILES=true
# يوم إعادة رفع الملفات كلها (1 الاثنين إلى 7 الأحد)، لئلا تنتهي نسخة ملف حي بقاعدة الثلاثين يوماً
BACKUP_FILES_REFRESH_WEEKDAY=7
