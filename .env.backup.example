# إعدادات النسخ الاحتياطي (scripts/backup.sh) — تُنسخ إلى .env.backup على الخادم (صلاحية 600).
# حاوية النسخ عند مزود ثانٍ (المرشح Hetzner)، منفصلة عن حاوية الملفات الحية، ومفاتيحها للكتابة بلا حذف
# (PutObject وListBucket بلا DeleteObject) على حاوية النسخ وحدها، والحاوية بقفل الكائنات بوضع الامتثال 30 يوماً شرطاً لا خياراً (deploy/storage/README.md).
# ومدة الاحتفاظ بقاعدة دورة الحياة في الحاوية (deploy/storage/lifecycle-backups.json)، لا من الخادم.
PGHOST=pgsql
PGPORT=5432
PGDATABASE=ejaz
# دور للقراءة وحدها يكفي pg_dump (docs/deploy.md): CREATE ROLE ejaz_backup LOGIN PASSWORD '...'; GRANT pg_read_all_data TO ejaz_backup;
PGUSER=ejaz_backup
PGPASSWORD=
# حاوية النسخ: فارغة في الوضع المحلي (آخر الملف، المعتمد للإطلاق على Hostinger). وأي قيمة فيها، ولو نص مثال، تشغّل وضع الحاوية
# فيطلب السكربت BACKUP_S3_ENDPOINT ومفتاحيه ويفشل بدونها. وعند الترقية اسمها، مثل: BACKUP_BUCKET=ejaz-backups
BACKUP_BUCKET=
BACKUP_S3_ENDPOINT=<عنوان واجهة S3 لحاوية النسخ، مثل https://fsn1.your-objectstorage.com>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=<منطقة حاوية النسخ، مثل fsn1>
# معرّف المفتاح العام (بريده أو بصمته)، وملفه على الخادم /etc/ejaz/backup-public.asc
BACKUP_GPG_RECIPIENT=
# نسخ الملفات: القرصان المحليان، وحاوية الملفات الخاصة على S3 إن ضُبطت أدناه. كلها مشفّرة عند العميل (rclone crypt)
BACKUP_SYNC_FILES=true
# يوم إعادة رفع الملفات كلها (1 الاثنين إلى 7 الأحد)، لئلا تنتهي نسخة ملف حي بقاعدة الثلاثين يوماً
BACKUP_FILES_REFRESH_WEEKDAY=7
# كلمتا سر تشفير الملفات (password وpassword2 في rclone crypt)، بنصهما، طويلتان عشوائيتان (openssl rand -base64 32).
# نسختهما في مدير كلمات المرور خارج الخادم مع مفتاح GPG الخاص (scripts/restore.md)، وإلا تعذر فك نسخ الملفات.
# ولا تُغيَّران بعد أول نسخة: ما شُفّر بالقديمتين لا يُفك بالجديدتين
BACKUP_CRYPT_PASSWORD=
BACKUP_CRYPT_SALT=
# حاوية الملفات الخاصة على S3 في الإنتاج (FILESYSTEM_PRIVATE_DISK=s3): اسمها وعنوانها ومنطقتها كـ AWS_* في .env التطبيق.
# none صراحةً إن كان القرص الخاص محلياً، وإلا يرفض السكربت العمل: نسيانه يترك الملفات الخاصة بلا نسخة. والمفتاح للقراءة وحدها إن أمكن عند المزود (deploy/storage/README.md)
BACKUP_SOURCE_S3_BUCKET=
BACKUP_SOURCE_S3_ENDPOINT=
BACKUP_SOURCE_S3_REGION=
BACKUP_SOURCE_ACCESS_KEY_ID=
BACKUP_SOURCE_SECRET_ACCESS_KEY=
# مدة خطوة الملفات كلها في التشغيل الواحد (رقم بلا لاحقة بالثواني، أو بـ s أو m أو h). وإن انقضت قبل اكتمال النسخ خرج السكربت برمز 75 بعد نسخة القاعدة (deploy/readiness.md §١٤)
BACKUP_FILES_MAX_DURATION=20h

# الوضع المحلي (قرار صفوان «مبدئياً على المجاني»، 6 نوفمبر 2026): بلا BACKUP_BUCKET تُحفظ نسخة القاعدة المشفّرة في هذا المجلد
# داخل الحاوية، وهو /var/backups/ejaz على الخادم (BACKUP_LOCAL_DIR_HOST في .env). والملفات لا تُنسخ في هذا الوضع.
# وللترقية إلى حاوية النسخ: تُضبط BACKUP_BUCKET وأخواتها أعلاه فيُتجاهل هذا.
# وفي وحدة systemd بلا حاويات (deploy/systemd/ejaz-backup.service) القيمة /var/backups/ejaz نفسها. ويُنشأ المجلد على الخادم
# بصلاحية 700 قبل أول نسخة: sudo install -d -m 700 /var/backups/ejaz (وبلا حاويات: -o ejaz-backup -g ejaz-backup، والمتغيرات في /etc/ejaz/backup.env)
BACKUP_LOCAL_DIR=/backups
BACKUP_LOCAL_KEEP_DAYS=7
