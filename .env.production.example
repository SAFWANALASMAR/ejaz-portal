# إعدادات الإنتاج — بوابة جمعية إعجاز (docs/deploy.md). يُنسخ إلى .env على الخادم (صلاحية 600) وتُملأ القيم
# الفارغة من مخزن الأسرار. لا سر في هذا الملف ولا في قيت. وكل ما بين <...> يُضبط عند اختيار المزود.
# يقرؤه compose (deploy/compose.production.yaml) للحاويات، وللتعويض في الملف نفسه بـ --env-file .env.
# بلا علامات اقتباس حول القيم إلا ما فيه مسافة.

# ملفا التعريف: bundled = PostgreSQL وRedis على الخادم نفسه. ومع قاعدة وذاكرة مُدارتين: يُحذف bundled
# وتُغيَّر DB_HOST/DB_PORT/DB_* وREDIS_* وحدها، بلا تغيير في الشيفرة
COMPOSE_PROFILES=bundled
EJAZ_TAG=latest

APP_NAME="جمعية إعجاز"
APP_ENV=production
# يُولَّد مرة: docker compose ... run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://ejaz.sa
# true في الإنتاج وحده بعد نقل النطاق (docs/cutover.md)، وfalse في التجريبية
SEO_INDEXABLE=false

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_DISPLAY_TIMEZONE=Asia/Riyadh
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# عناوين موزع الأحمال بعينها، أو فارغة إن لم يوجد موزع ويصل الزوار إلى الخادم مباشرة (docs/security.md)
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ejaz
DB_USERNAME=ejaz
DB_PASSWORD=
# ضبط PostgreSQL المضمّن لخادم 16 جيجابايت (docs/deploy/provider-checklist.md)
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ejaz

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAXMEMORY=1gb

# التخزين بواجهة S3 القياسية لدى مزود داخل المملكة (decisions.md، 11 أكتوبر 2026). مثال أوراكل:
# AWS_ENDPOINT=https://<namespace>.compat.objectstorage.me-jeddah-1.oraclecloud.com وAWS_USE_PATH_STYLE_ENDPOINT=true
FILESYSTEM_PRIVATE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=<منطقة المزود>
AWS_BUCKET=<حاوية الملفات الخاصة>
AWS_ENDPOINT=<عنوان واجهة S3 للمزود>
AWS_USE_PATH_STYLE_ENDPOINT=true
# when_required إن رفض المزود مجاميع التحقق الإضافية (docs/deploy/provider-checklist.md)
AWS_REQUEST_CHECKSUM_CALCULATION=when_supported
AWS_RESPONSE_CHECKSUM_VALIDATION=when_supported

# سياسة أمان المحتوى: نطاق التخزين للرفع المباشر، وشبكة التوصيل إن قُدّمت منها الصور
CSP_IMG_SRC=
CSP_CONNECT_SRC=<عنوان واجهة S3 للمزود>
CSP_MEDIA_SRC=
CSP_FORM_ACTION=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<مزود البريد>
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@ejaz.sa
MAIL_FROM_NAME="جمعية إعجاز"

# مزود الرسائل النصية بانتظار اعتماده (open-questions.md). log يرفضه التطبيق في الإنتاج
SMS_DRIVER=log
SMS_SENDER=
SMS_PER_HOUR=5000

# fake يُرفض في الإنتاج عند أول ضيف في استبيان مفتوح للضيوف؛ وturnstile بمفتاحيه إن سُمح للضيوف (security.md)
BOT_CHALLENGE_DRIVER=fake
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# fake يرفض حفظ اجتماع عن بعد في الإنتاج برسالة ظاهرة؛ وgraph بمفاتيح حساب 365 عند توفره
ONLINE_MEETINGS_DRIVER=fake
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_ORGANIZER=

ACTIVITYLOG_RETENTION_DAYS=365
ADMIN_IDLE_MINUTES=30

# الرفع المباشر لمقاطع المسابقات إلى التخزين (decisions.md)
COMPETITION_VIDEO_UPLOAD=s3
COMPETITION_VIDEO_URL_MINUTES=30
COMPETITION_VIDEO_FFPROBE=ffprobe

STORE_URL=https://ejaz.org.sa
STORE_ALLOWED_HOSTS=ejaz.org.sa
STORE_DRIVER=settings
PAYMENTS_ENABLED=false
PAYMENT_DRIVER=fake

HEALTH_QUEUE_MAX_BACKLOG=1000
HEALTH_FAILED_JOBS_MAX=0
HEALTH_DISK_MIN_FREE_PERCENT=10
HEALTH_SCHEDULE_MAX_SILENCE_MINUTES=5

# عدد عمليات PHP-FPM (لا يقل عن 16)
FPM_MAX_CHILDREN=40
