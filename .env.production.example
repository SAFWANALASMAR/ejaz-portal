# إعدادات الإنتاج — بوابة جمعية إعجاز (docs/deploy.md). يُنسخ إلى .env على الخادم (صلاحية 600) وتُملأ القيم
# الفارغة من مدير كلمات المرور المعتمد لدى الجمعية (docs/deploy.md). لا سر في هذا الملف ولا في قيت. وكل ما بين <...> يُضبط عند اختيار المزود.
# يقرؤه compose (deploy/compose.production.yaml) للحاويات، وللتعويض في الملف نفسه بـ --env-file .env.
# بلا علامات اقتباس حول القيم إلا ما فيه مسافة.

# ملفا التعريف: bundled = PostgreSQL وRedis على الخادم نفسه. ومع قاعدة وذاكرة مُدارتين: يُحذف bundled
# وتُغيَّر DB_HOST/DB_PORT/DB_* وREDIS_* وحدها، بلا تغيير في الشيفرة
COMPOSE_PROFILES=bundled
# الإصدار العامل: يكتبه scripts/deploy-compose.sh عند كل نشر، فتبقى الحاويات عليه بعد إعادة التشغيل.
# والتراجع: الوسم السابق هنا ثم up -d (docs/cutover.md)
EJAZ_TAG=latest
# النطاق في nginx (server_name والتحويل إلى https): ejaz.sa في الإنتاج، ونطاق التجريبية فيها
SITE_HOST=ejaz.sa

APP_NAME="جمعية إعجاز"
APP_ENV=production
# يُولَّد مرة: docker compose ... run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://ejaz.sa
# true في الإنتاج وحده بعد نقل النطاق (docs/cutover.md)، وfalse في التجريبية
SEO_INDEXABLE=false

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_DISPLAY_TIMEZONE=Asia/Riyadh
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# عناوين موزع الأحمال بعينها مفصولة بفاصلة، أو فارغة إن لم يوجد موزع ويصل الزوار إلى الخادم مباشرة (docs/security.md).
# لا TRUSTED_PROXIES=* إلا والخادم معزول في الشبكة لا يصله إلا الموزع، والموزع يستبدل رأس X-Forwarded-For كاملاً،
# وإلا زوّر أي زائر عنوانه برأس وتجاوز حدود الشبكات. وسكربت النشر ينبّه إن بقيت *
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=ejaz
DB_USERNAME=ejaz
DB_PASSWORD=
# ضبط PostgreSQL المضمّن لخادم 16 جيجابايت. ولخادم 32 و64 جيجابايت (Cloud VDS XL، قرار 18 أكتوبر 2026)
# القيم في docs/deploy/provider-checklist.md، فتُكتب في .env على الخادم ولا تُغيَّر هنا
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=256MB

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ejaz

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
# لخادم 16 جيجابايت. ولخادم 32 و64 جيجابايت القيمة في docs/deploy/provider-checklist.md
REDIS_MAXMEMORY=1gb

# التخزين بواجهة S3 القياسية (decisions.md، 11 و18 أكتوبر 2026). مثال Contabo، المرشح للملفات، بنمط المسار وحده:
# AWS_ENDPOINT=https://eu2.contabostorage.com وAWS_USE_PATH_STYLE_ENDPOINT=true، والمنطقة في أمثلته default
# (يُجرَّب على التجريبي — docs/deploy/provider-checklist.md)
FILESYSTEM_PRIVATE_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=<منطقة المزود>
AWS_BUCKET=<حاوية الملفات الخاصة>
AWS_ENDPOINT=<عنوان واجهة S3 للمزود>
AWS_USE_PATH_STYLE_ENDPOINT=true
# when_required إن رفض المزود مجاميع التحقق الإضافية (docs/deploy/provider-checklist.md)
AWS_REQUEST_CHECKSUM_CALCULATION=when_supported
AWS_RESPONSE_CHECKSUM_VALIDATION=when_supported

# سياسة أمان المحتوى: نطاق التخزين للرفع المباشر، وشبكة التوصيل إن قُدّمت منها الصور. وملفات الحوكمة والمكتبة
# تُحوَّل إلى رابط تخزين موقّع (CONTENT_FILE_URL_MINUTES)، فنطاق التخزين في CSP_MEDIA_SRC للصوت وCSP_FRAME_SRC لعرض PDF مدمجاً
CSP_IMG_SRC=
CSP_CONNECT_SRC=<عنوان واجهة S3 للمزود>
CSP_MEDIA_SRC=<عنوان واجهة S3 للمزود>
CSP_FRAME_SRC=<عنوان واجهة S3 للمزود>
CSP_FORM_ACTION=
CONTENT_FILE_URL_MINUTES=60

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<مزود البريد>
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@ejaz.sa
MAIL_FROM_NAME="جمعية إعجاز"

# مزود الرسائل النصية بانتظار اعتماده (open-questions.md). log يرفضه التطبيق في الإنتاج
SMS_DRIVER=log
SMS_SENDER=
SMS_PER_HOUR=5000

# استبيان الرضا للضيوف بـ Cloudflare Turnstile (قرار صفوان، 19 أكتوبر 2026 — decisions.md). المفتاحان من لوحة
# Cloudflare للنطاق، والسري في مدير كلمات المرور. وبلا أحدهما يُرفض أول ضيف برسالة، ويفحصه verify-server.sh --server
BOT_CHALLENGE_DRIVER=turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# fake يرفض حفظ اجتماع عن بعد في الإنتاج برسالة ظاهرة؛ وgraph بمفاتيح حساب 365 عند توفره
ONLINE_MEETINGS_DRIVER=fake
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_ORGANIZER=

ACTIVITYLOG_RETENTION_DAYS=365
ADMIN_IDLE_MINUTES=30
ADMIN_SESSION_MAX_MINUTES=480

# الرفع المباشر لمقاطع المسابقات إلى التخزين (decisions.md)
COMPETITION_VIDEO_UPLOAD=s3
COMPETITION_VIDEO_URL_MINUTES=30
COMPETITION_VIDEO_FFPROBE=ffprobe
# رفع ملفات اللوحة (حتى 200 ميجابايت: الفيديو التعريفي ووسائط الأسئلة) من المتصفح إلى التخزين مباشرة، فلا ترتفع
# حدود nginx وPHP العامة. يلزمه CORS الحاوية وCSP_CONNECT_SRC، وقاعدة حذف livewire-tmp/ بعد يوم (deploy/storage/)
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=s3

# عمال طابور المقاطع المستقل (Horizon: supervisor-videos، مهلة المهمة 900 ثانية)
COMPETITION_VIDEO_WORKERS=2
# فوق مهلة أطول مهمة (900)، وإلا التقط عامل آخر مقطعاً ما زال يُعالج فعولج مرتين
REDIS_QUEUE_RETRY_AFTER=960

# شهادة الحضور لا تُصدر حتى يُستبدل القالب المؤقت بقالب الجمعية المعتمد (config/programs.php)
PROGRAM_CERTIFICATE_TEMPLATE_READY=false

STORE_URL=https://ejaz.org.sa
STORE_ALLOWED_HOSTS=ejaz.org.sa
STORE_DRIVER=settings
PAYMENTS_ENABLED=false
PAYMENT_DRIVER=fake

HEALTH_QUEUE_MAX_BACKLOG=1000
HEALTH_VIDEO_QUEUE_MAX_BACKLOG=100
HEALTH_FAILED_JOBS_MAX=0
HEALTH_DISK_MIN_FREE_PERCENT=10
HEALTH_SCHEDULE_MAX_SILENCE_MINUTES=5

# عدد عمليات PHP-FPM (لا يقل عن 16) لخادم 16 جيجابايت. ولخادم 32 و64 جيجابايت القيمة في docs/deploy/provider-checklist.md
FPM_MAX_CHILDREN=40
